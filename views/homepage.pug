doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    a(href="/update-cobj") Add to this table
    h1 Books
    table
      thead
        tr
          th Name
          th Author
          th Genre
      tbody
        each record in data
          tr
            td= record.properties.name
            td= record.properties.author
            td= record.properties.genre